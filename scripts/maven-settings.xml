<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven's settings for the SDK's scripts: every download comes from Maven Central, whatever a pom
     names, by a mirror of every repository. The mirror's id is central, Maven's own for Central, so
     that what this machine holds from Central is read as Central's. It names no credentials. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>central</id>
      <name>Maven Central</name>
      <mirrorOf>*</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
  </mirrors>
</settings>
